# URL pública de n8n (sin /webhook). Solo la usan el proxy de Vite y el build de Netlify;
# no se incluye en el código del navegador.
N8N_BASE_URL=https://n8n.tudominio.com

# true = la app usa datos de prueba guardados en el navegador (Fase 2).
# false = la app habla con n8n a través de /api.
VITE_USE_MOCKS=true
